# Public-safe environment template. Copy to a private .env file and replace placeholders locally.

MONGODB_URI=<mongodb-uri>
MONGODB_DATABASE=student_db
MONGODB_RESERVATION_COLLECTION=reservation
MONGODB_AUTH_COLLECTION=auth_collection
DEADLINE_COMMAND=C:\Program Files\Thinkbox\Deadline10\bin\deadlinecommand.exe
DEADLINE_DEFAULT_POOL=none
DEADLINE_DEFAULT_GROUP=none
DEADLINE_DEFAULT_PRIORITY=50
DEADLINE_DEFAULT_CHUNK_SIZE=1
DEADLINE_REPOSITORY=\\<internal-server-name>\<internal-path>
NAS_ROOT=\\<nas-server-ip>\<internal-path>
GOOGLE_SHEET_URL=<google-sheet-url>
GOOGLE_SERVICE_ACCOUNT_JSON=<internal-path>\google_creds.json
GOOGLE_SPREADSHEET_NAME=<google-spreadsheet-name>
GOOGLE_WORKSHEET_NAME=<google-worksheet-name>
ARNOLD_LICENSE_SERVER=<license-server-ip>
OCIO_CONFIG=\\<nas-server-ip>\<internal-path>\config.ocio
MAYA_SCRIPT_PATH=<local-maya-script-path>
PYTHON_EXTRA_SITE_PACKAGES=<optional-local-site-packages-path>

